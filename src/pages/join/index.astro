---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MissionCarousel from '../../components/MissionCarousel';
import Footer from '../../components/Footer';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Get Involved — Y.E.S." description="Learn how you can participate in global missions through Yielded Evangelical Servants. Pray, participate, and give.">

  <!-- Hero -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-28 overflow-hidden bg-[var(--color-bg)]">
    <div class="absolute font-heading font-bold text-[clamp(4rem,16vw,14rem)] top-[45%] left-1/2 -translate-x-1/2 leading-none pointer-events-none select-none whitespace-nowrap" style="color:rgba(44,74,62,0.06)" aria-hidden="true">INVOLVED</div>
    <div class="float-line h-[30vh] top-[10%] left-[4%]" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6">
      <p class="text-[var(--color-accent)] text-xs tracking-[0.25em] uppercase font-medium mb-4">Romans 10:15</p>
      <h1 class="font-heading text-4xl md:text-6xl lg:text-7xl font-light text-[var(--color-primary)] leading-[1.05] mb-6">
        Get Involved
      </h1>
      <p class="font-heading italic text-[var(--color-text-muted)] text-lg md:text-xl leading-relaxed max-w-xl">
        &ldquo;And how can anyone preach unless they are sent?&rdquo;
      </p>
    </div>
  </section>

  <!-- Become a missionary -->
  <section class="py-20 md:py-28 bg-[var(--color-bg)]">
    <div class="max-w-5xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <MissionCarousel base={base} client:visible />
      </div>
      <div>
        <p class="text-[var(--color-accent)] text-xs tracking-[0.25em] uppercase font-medium mb-3">Answer the Call</p>
        <h2 class="font-heading text-3xl md:text-4xl font-light text-[var(--color-primary)] mb-6 leading-tight">
          Become a Missionary
        </h2>
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-8">
          If you feel called to serve, Y.E.S. can help you take the next step. We provide the organizational and financial infrastructure missionaries need so they can focus entirely on their ministry.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={`${base}download/YES_Application_for_Associate_Missionary_Sept2018.docx`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 bg-[var(--color-accent)] text-white font-medium rounded transition-opacity duration-300 hover:opacity-90 text-center"
          >
            Missionary Application
          </a>
          <a
            href={`${base}download/YES_Member_Handbook_Aug2021.docx`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 border border-[var(--color-primary)]/30 text-[var(--color-primary)] font-medium rounded transition-all duration-300 hover:bg-[var(--color-primary)] hover:text-white text-center"
          >
            Member Handbook
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-bleed image break -->
  <div class="relative h-64 md:h-80 overflow-hidden">
    <img src={`${base}Yespic/2.jpg`} alt="Missionaries" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-[var(--color-primary)]/55"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6">
      <p class="font-heading text-white text-2xl md:text-4xl font-light max-w-2xl leading-tight">
        Every calling deserves a structure that lets it thrive.
      </p>
    </div>
  </div>

  <!-- Ways to help -->
  <section class="py-20 md:py-28 bg-[var(--color-surface)]">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[var(--color-accent)] text-xs tracking-[0.25em] uppercase font-medium mb-3">Three Ways</p>
        <h2 class="font-heading text-3xl md:text-5xl font-light text-[var(--color-primary)] leading-tight">
          Ways To Help
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            label: '01',
            title: 'Pray',
            body: 'Prayer is the foundation of missions. Keep our missionaries in your daily prayers — especially those serving in dangerous or restricted regions.',
            icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
          },
          {
            label: '02',
            title: 'Participate',
            body: 'Join a short-term mission trip, volunteer your skills, or connect with missionaries who need help in their ministry.',
            icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0',
          },
          {
            label: '03',
            title: 'Give',
            body: 'Financial support enables missionaries to stay on the field. Every gift, no matter the size, makes an eternal difference.',
            icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
          },
        ].map((item) => (
          <div class="bg-[var(--color-bg)] rounded-2xl p-8 relative overflow-hidden">
            <span class="absolute top-5 right-6 font-heading text-5xl font-bold text-[var(--color-primary)]/5">{item.label}</span>
            <div class="w-11 h-11 bg-[var(--color-accent)]/10 rounded-full flex items-center justify-center mb-5">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={item.icon} />
              </svg>
            </div>
            <h3 class="font-heading text-xl font-medium text-[var(--color-primary)] mb-3">{item.title}</h3>
            <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer base={base} client:visible />
</BaseLayout>
