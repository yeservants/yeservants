---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer';
import PageHero from '../../components/PageHero';
import ContactBody from '../../components/ContactBody';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Web3Forms access key (free, from web3forms.com — safe to expose by design).
// Set PUBLIC_WEB3FORMS_KEY in the build env (.env or the GitHub Actions workflow).
// While empty, the form gracefully falls back to a mailto: link.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

const description =
  'Whether you want to become a partner, send a team, ask about a specific worker, or just learn more — we want to hear from you.';
---

<BaseLayout title="Contact — YES | Yielded Evangelical Servants" description={description}>
  <!-- Opener — "Let's Talk." -->
  <PageHero
    eyebrowKey="contact_opener_label"
    headlineKey="contact_opener_headline"
    introKey="contact_opener_body"
    client:load
  />

  <!-- Two columns: info left, form right + John 13:35 close -->
  <ContactBody base={base} web3formsKey={web3formsKey} client:visible />

  <Footer base={base} client:visible />
</BaseLayout>
