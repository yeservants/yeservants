---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Contact Us — Y.E.S." description="Get in touch with Yielded Evangelical Servants. Contact us for information about missionaries, donations, or getting involved.">

  <!-- Hero -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-28 overflow-hidden bg-[var(--color-bg)]">
    <div class="absolute font-heading font-bold text-[clamp(4rem,16vw,14rem)] top-[45%] left-1/2 -translate-x-1/2 leading-none pointer-events-none select-none whitespace-nowrap" style="color:rgba(44,74,62,0.06)" aria-hidden="true">CONTACT</div>
    <div class="float-line h-[30vh] top-[10%] left-[4%]" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6">
      <p class="text-[var(--color-accent)] text-xs tracking-[0.25em] uppercase font-medium mb-4">We'd Love to Hear From You</p>
      <h1 class="font-heading text-4xl md:text-6xl lg:text-7xl font-light text-[var(--color-primary)] leading-[1.05] mb-6">
        Contact Us
      </h1>
      <p class="text-[var(--color-text-muted)] text-lg md:text-xl leading-relaxed max-w-2xl">
        Have a question about missionaries, donations, or getting involved? Reach out — we'd love to connect with you.
      </p>
    </div>
  </section>

  <!-- Contact info -->
  <section class="py-20 md:py-28 bg-[var(--color-bg)]">
    <div class="max-w-5xl mx-auto px-6 grid md:grid-cols-2 gap-12">

      <!-- Email -->
      <div>
        <p class="text-[var(--color-accent)] text-xs tracking-[0.25em] uppercase font-medium mb-3">Email</p>
        <h2 class="font-heading text-2xl md:text-3xl font-light text-[var(--color-primary)] mb-6 leading-tight">
          Reach Out Anytime
        </h2>
        <div class="flex flex-col gap-5 mb-8">
          <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-primary)]/5">
            <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide mb-1">General Inquiries</p>
            <a href="mailto:info@yeservants.org" class="text-[var(--color-accent)] font-medium hover:underline text-lg">
              info@yeservants.org
            </a>
          </div>
          <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-primary)]/5">
            <p class="text-xs text-[var(--color-text-muted)] uppercase tracking-wide mb-1">Accounting &amp; Donations</p>
            <a href="mailto:accounting@yeservants.org" class="text-[var(--color-accent)] font-medium hover:underline text-lg">
              accounting@yeservants.org
            </a>
          </div>
        </div>
        <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">
          Y.E.S. does not handle donation requests directly. To support a missionary, visit their profile page or our
          <a href={`${base}donate/`} class="text-[var(--color-accent)] underline hover:opacity-80">donation page</a>.
        </p>
      </div>

      <!-- Address + social -->
      <div>
        <p class="text-[var(--color-accent)] text-xs tracking-[0.25em] uppercase font-medium mb-3">Address</p>
        <h2 class="font-heading text-2xl md:text-3xl font-light text-[var(--color-primary)] mb-6 leading-tight">
          Find Us
        </h2>
        <div class="p-8 rounded-2xl bg-[var(--color-primary)] text-white mb-6">
          <address class="not-italic leading-relaxed mb-5">
            <strong class="text-white font-medium block mb-1">Yielded Evangelical Servants, Inc.</strong>
            <span class="text-white/60">PO Box 770308<br />Orlando, FL 32837</span>
          </address>
          <a href="tel:4074985128" class="text-[var(--color-accent)] font-medium hover:underline text-lg">
            407-498-5128
          </a>
        </div>

        <!-- Social -->
        <div class="flex gap-4">
          <a
            href="https://www.facebook.com/profile.php?id=100080058171515"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-3 rounded-xl bg-[var(--color-surface)] text-[var(--color-primary)] text-sm font-medium hover:bg-[var(--color-primary)] hover:text-white transition-all duration-300"
          >
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073c0 6.027 4.388 11.025 10.125 11.928v-8.437H7.078v-3.49h3.047V9.43c0-3.006 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.491h-2.796v8.437C19.612 23.098 24 18.1 24 12.073z"/></svg>
            Facebook
          </a>
          <a
            href="https://www.instagram.com/yeservants"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-3 rounded-xl bg-[var(--color-surface)] text-[var(--color-primary)] text-sm font-medium hover:bg-[var(--color-primary)] hover:text-white transition-all duration-300"
          >
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            Instagram
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-bleed image break -->
  <div class="relative h-60 md:h-72 overflow-hidden">
    <img src={`${base}Yespic/IMG-20240810-WA0009.jpg`} alt="Mission field" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-[var(--color-primary)]/60"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6">
      <p class="font-heading text-white text-xl md:text-3xl font-light max-w-xl leading-relaxed">
        Interested in becoming a missionary with Y.E.S.?
      </p>
      <a href={`${base}join/`} class="mt-5 px-7 py-3 bg-[var(--color-accent)] text-white font-medium rounded transition-opacity hover:opacity-90 text-sm">
        Learn How to Join →
      </a>
    </div>
  </div>

  <Footer base={base} client:visible />
</BaseLayout>
