---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer';
import PageHero from '../../components/PageHero';
import HiwPartnershipSteps from '../../components/HiwPartnershipSteps';
import HiwWhatSupportCovers from '../../components/HiwWhatSupportCovers';
import HiwFunds from '../../components/HiwFunds';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// FINAL v2 meta description (How It Works)
const description =
  'YES provides sustained monthly partnership — financial and logistical — to vetted Gospel workers. Not project-based. For the long haul.';
---

<BaseLayout title="How It Works · YES (Yielded Evangelical Servants)" description={description}>
  <!-- Opener — "Real Partnership With Real People." -->
  <PageHero eyebrowKey="hiw_opener_label" headlineKey="hiw_opener_headline" introKey="hiw_opener_body" client:load />

  <!-- Block 1 — How a Partnership Begins (5 steps) -->
  <HiwPartnershipSteps client:visible />

  <!-- Block 2 — What Support Actually Covers (#financial / #logistical anchors) -->
  <HiwWhatSupportCovers client:visible />

  <!-- Block 3 — Where Your Support Goes. Specifically. -->
  <HiwFunds base={base} client:visible />

  <Footer base={base} client:visible />
</BaseLayout>
