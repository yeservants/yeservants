---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MissionaryDetail from '../../../components/MissionaryDetail';
import Footer from '../../../components/Footer';

const portraitModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.{jpg,jpeg,png}',
  { eager: true }
);

export async function getStaticPaths() {
  const all = await getCollection('missionaries');
  return all.map((m) => ({
    params: { slug: m.data.url },
    props: { missionary: m.data },
  }));
}

const { missionary } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Optimise portrait
const key = `/src/assets/images/${missionary.picture}`;
const mod = portraitModules[key];
let pictureUrl: string | undefined;
if (mod?.default) {
  const opt = await getImage({ src: mod.default, format: 'webp', width: 800, quality: 85 });
  pictureUrl = opt.src;
}
---

<BaseLayout
  title={`${missionary.name} — Y.E.S. Missionary`}
  description={missionary.description}
  ogImage={`/images/${missionary.picture}`}
  ogType="article"
>
  <MissionaryDetail missionary={{ ...missionary, pictureUrl }} base={base} client:load />
  <Footer base={base} client:visible />
</BaseLayout>
