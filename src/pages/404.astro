---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer';
import GreenAtmos from '../components/GreenAtmos';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Page Not Found — Y.E.S." description="The page you are looking for could not be found." noindex={true}>
  {/* Espresso band — same header language as PageHero (nav consistency) */}
  <section class="relative overflow-hidden green-gradient text-[var(--color-cream)] pt-32 pb-16 md:pt-40 md:pb-20 min-h-[70vh] flex items-center">
    <GreenAtmos variant={1} />
    <div class="relative z-10 w-full max-w-3xl mx-auto px-6 text-center">
      <p class="font-heading text-8xl md:text-[10rem] font-light text-[var(--color-cream)]/10 leading-none mb-4 select-none">
        404
      </p>
      <h1 class="font-heading font-medium leading-[1.06] text-[clamp(2.1rem,4.6vw,3.9rem)] text-[var(--color-cream)] mb-6">
        Page Not Found
      </h1>
      <p class="text-[var(--color-cream)]/70 max-w-md mx-auto leading-relaxed mb-10">
        The page you are looking for may have been moved or no longer exists. Let us help you find your way.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${base}`}
          class="px-8 py-3.5 bg-[var(--color-accent-deep)] text-white text-sm font-semibold tracking-wide rounded-full transition-colors duration-300 hover:bg-[var(--color-accent-hover)] text-center"
        >
          Go Home
        </a>
        <a
          href={`${base}missionaries/`}
          class="px-8 py-3.5 border border-[var(--color-cream)]/35 text-[var(--color-cream)] text-sm font-semibold tracking-wide rounded-full transition-colors duration-300 hover:bg-[var(--color-cream)]/10 text-center"
        >
          The Missionaries
        </a>
      </div>
    </div>
  </section>

  <Footer base={base} client:visible />
</BaseLayout>
