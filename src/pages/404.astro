---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Page Not Found — Y.E.S." description="The page you are looking for could not be found.">
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden atmos-glow-center min-h-[60vh] flex items-center">
    <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
      <p class="font-heading text-8xl md:text-[10rem] font-light text-[var(--color-primary)]/10 leading-none mb-4 select-none">
        404
      </p>
      <h1 class="font-heading text-3xl md:text-5xl font-light text-[var(--color-primary)] mb-6 leading-tight">
        Page Not Found
      </h1>
      <p class="text-[var(--color-text-muted)] max-w-md mx-auto leading-relaxed mb-10">
        The page you are looking for may have been moved or no longer exists. Let us help you find your way.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${base}`}
          class="px-8 py-3.5 bg-[var(--color-accent)] text-white font-medium rounded transition-opacity duration-300 hover:opacity-90 text-center"
        >
          Go Home
        </a>
        <a
          href={`${base}missionaries/`}
          class="px-8 py-3.5 border border-[var(--color-primary)]/30 text-[var(--color-primary)] font-medium rounded transition-all duration-300 hover:bg-[var(--color-primary)] hover:text-white text-center"
        >
          Our Missionaries
        </a>
      </div>
    </div>
  </section>

  <Footer base={base} client:visible />
</BaseLayout>
