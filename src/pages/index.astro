---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import HomeLetter from '../components/HomeLetter';
import HomeInsight from '../components/HomeInsight';
import HomeWhatYesDoes from '../components/HomeWhatYesDoes';
import HomeWhyItWorks from '../components/HomeWhyItWorks';
import HomeBiblical from '../components/HomeBiblical';
import HomeFinalCta from '../components/HomeFinalCta';
import Footer from '../components/Footer';

// Hero carousel field photos → WebP (dignified, real field photography)
import hero1Src from '../assets/images/yespic/IMG-20240810-WA0010.jpg';
import hero2Src from '../assets/images/yespic/IMG-20240810-WA0012.jpg';
import hero3Src from '../assets/images/yespic/IMG-20240810-WA0009.jpg';
import hero4Src from '../assets/images/yespic/9.jpg';

// Letter story photos — stand-ins; CLIENT must replace with verified location photos
import crSrc from '../assets/images/yespic/1.jpg';                   // Bajo Rodriguez, Costa Rica
import hnSrc from '../assets/images/yespic/IMG-20240810-WA0007.jpg'; // Mata Hambre, Honduras
import phSrc from '../assets/images/yespic/2.jpg';                   // Ozamiz, Philippines

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const heroSrcs = [hero1Src, hero2Src, hero3Src, hero4Src];
const heroImages = (
  await Promise.all(
    heroSrcs.map((src) => getImage({ src, format: 'webp', width: 880, height: 1100, quality: 82 }))
  )
).map((img) => img.src);

/* CLIENT: replace stand-in photos with verified field photos for each location */
const crImg = await getImage({ src: crSrc, format: 'webp', width: 720, height: 540, quality: 82 });
const hnImg = await getImage({ src: hnSrc, format: 'webp', width: 720, height: 540, quality: 82 });
const phImg = await getImage({ src: phSrc, format: 'webp', width: 720, height: 540, quality: 82 });

// FINAL v2 meta description (homepage)
const description =
  'Behind every missionary is a story no one sees. YES stands with faithful Gospel workers already in the field, carrying more than anyone should carry alone. Since 1990.';

// Transparency seal lives in public/ — referenced directly
const sealSrc = `${base}images/candid-seal-platinum-2025.png`;
---

<BaseLayout title="Behind Every Missionary Is a Story No One Sees · YES (Yielded Evangelical Servants)" description={description} preloadImage={heroImages[0]}>
  {/* Block 1 — Hero: the letter opens (eyebrow, headline, block quote) */}
  <Hero base={base} heroImages={heroImages} client:load />

  {/* Block 1 (cont.) — What I've Seen: the letter body with the three field stories */}
  <HomeLetter
    base={base}
    crImg={{ src: crImg.src, alt: "A faithful pastor and his congregation in Bajo Rodriguez, Costa Rica — stand-in photo" }}
    hnImg={{ src: hnImg.src, alt: "Gospel workers serving in the Mata Hambre community, Honduras — stand-in photo" }}
    phImg={{ src: phImg.src, alt: "Ministry leaders serving in Ozamiz, Philippines — stand-in photo" }}
    client:visible
  />

  {/* Block 2 — The Insight (single centered card) */}
  <HomeInsight base={base} client:visible />

  {/* Block 3 — What YES Does (two cards: financial + logistical) */}
  <HomeWhatYesDoes base={base} client:visible />

  {/* Block 4 — Why It Works (paragraph + stat row) */}
  <HomeWhyItWorks base={base} sealSrc={sealSrc} client:visible />

  {/* Block 5 — The Biblical Foundation (4 scripture cards) */}
  <HomeBiblical base={base} client:visible />

  {/* Block 6 — Final CTA (orange box, signed by Andres) */}
  <HomeFinalCta base={base} client:visible />

  <Footer base={base} client:visible />
</BaseLayout>
