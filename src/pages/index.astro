---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import MissionStrip from '../components/MissionStrip';
import MissionIntro from '../components/MissionIntro';
import StatsRow from '../components/StatsRow';
import FeaturedMissionaries from '../components/FeaturedMissionaries';
import AboutSection from '../components/AboutSection';
import VisionSection from '../components/VisionSection';
import LeadershipSection from '../components/LeadershipSection';
import StatementOfFaith from '../components/StatementOfFaith';
import ICFCSection from '../components/ICFCSection';
import SponsorsSection from '../components/SponsorsSection';
import Testimonials from '../components/Testimonials';
import CandidSection from '../components/CandidSection';
import Footer from '../components/Footer';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allMissionaries = await getCollection('missionaries');
const featured = allMissionaries
  .filter((m) => m.data.picture !== 'none.jpg')
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .slice(0, 3)
  .map((m) => m.data);
---

<BaseLayout title="Y.E.S. — Yielded Evangelical Servants" description="Yielded Evangelical Servants is a nonprofit supporting evangelical missionaries worldwide since 2002. Pray, give, and go.">
  <Hero base={base} client:load />
  <MissionStrip client:visible />
  <MissionIntro client:visible />

  <!-- Full-bleed image break 1 -->
  <div class="relative h-72 md:h-[28rem] overflow-hidden">
    <img src={`${base}Yespic/9.jpg`} alt="Missionaries serving" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-[var(--color-primary)]/55"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6">
      <p class="text-[var(--color-accent)] text-xs tracking-[0.3em] uppercase font-medium mb-3">Our Purpose</p>
      <p class="font-heading text-white text-2xl md:text-4xl lg:text-5xl font-light leading-tight max-w-3xl italic">
        &ldquo;Go therefore and make disciples of all nations.&rdquo;
      </p>
      <p class="text-white/50 text-sm tracking-[0.2em] uppercase mt-4">Matthew 28:19</p>
    </div>
  </div>

  <StatsRow client:visible />
  <FeaturedMissionaries missionaries={featured} base={base} client:visible />

  <!-- Full-bleed image break 2 -->
  <div class="relative h-72 md:h-96 overflow-hidden">
    <img src={`${base}Yespic/IMG-20240810-WA0010.jpg`} alt="Mission field" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-[var(--color-primary)]/60"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6">
      <p class="text-[var(--color-accent)] text-xs tracking-[0.3em] uppercase font-medium mb-4">Founded 1990</p>
      <p class="font-heading text-white text-2xl md:text-4xl font-light leading-tight max-w-2xl">
        35+ years of serving missionaries<br/>across 20+ nations worldwide.
      </p>
      <a href={`${base}about/`} class="mt-6 inline-flex items-center gap-2 text-white/70 text-sm hover:text-white transition-colors duration-300">
        Our story
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>

  <AboutSection client:visible />
  <VisionSection base={base} client:visible />

  <!-- Full-bleed image break 3 -->
  <div class="relative h-64 md:h-80 overflow-hidden">
    <img src={`${base}Yespic/IMG-20240810-WA0012.jpg`} alt="Mission work" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="absolute inset-0 flex items-center justify-center text-center px-6">
      <div>
        <p class="text-[var(--color-accent)] text-xs tracking-[0.3em] uppercase font-medium mb-3">Get Involved</p>
        <p class="font-heading text-white text-2xl md:text-3xl font-light max-w-xl">Whether you give, go, or send — you help change eternity.</p>
        <div class="flex gap-4 justify-center mt-6">
          <a href={`${base}donate/`} class="px-6 py-2.5 bg-[var(--color-accent)] text-white text-sm font-medium rounded hover:opacity-90 transition-opacity">Donate</a>
          <a href={`${base}send-a-team/`} class="px-6 py-2.5 border border-white/40 text-white text-sm font-medium rounded hover:bg-white/10 transition-colors">Send a Team</a>
        </div>
      </div>
    </div>
  </div>

  <LeadershipSection base={base} client:visible />
  <StatementOfFaith client:visible />
  <ICFCSection client:visible />
  <SponsorsSection base={base} client:visible />
  <Testimonials client:visible />
  <CandidSection base={base} client:visible />
  <Footer base={base} client:visible />
</BaseLayout>
