---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import HomeStats from '../components/HomeStats';
import HomeInvestment from '../components/HomeInvestment';
import HomeDifferent from '../components/HomeDifferent';
import HomeModel from '../components/HomeModel';
import HomeSupport from '../components/HomeSupport';
import HomeProjects from '../components/HomeProjects';
import HomeBiblical from '../components/HomeBiblical';
import HomeTrust from '../components/HomeTrust';
import HomeFinalCta from '../components/HomeFinalCta';
import HomeMissionaries from '../components/HomeMissionaries';
import Footer from '../components/Footer';

// Hero carousel field photos → WebP (dignified, real field photography)
import hero1Src from '../assets/images/yespic/IMG-20240810-WA0010.jpg';
import hero2Src from '../assets/images/yespic/IMG-20240810-WA0012.jpg';
import hero3Src from '../assets/images/yespic/IMG-20240810-WA0009.jpg';

// Andrés González — President of YES (Final CTA portrait)
import andresSrc from '../assets/images/andres.jpeg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const heroSrcs = [hero1Src, hero2Src, hero3Src];
const heroImages = (
  await Promise.all(
    heroSrcs.map((src) => getImage({ src, format: 'webp', width: 880, height: 1100, quality: 82 }))
  )
).map((img) => img.src);

/* CLIENT: Andrés' current field photo; an in-action ministry shot may replace it if available */
const andresImg = await getImage({ src: andresSrc, format: 'webp', width: 640, height: 720, quality: 82 });

// ── The Missionaries procession (bottom carousel) ─────────────────────────
// Same portrait pipeline as /missionaries/ — anonymous workers ('none.jpg')
// and entries without a resolvable photo are excluded from the strip.
const portraitModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.{jpg,jpeg,png}',
  { eager: true }
);
const allWorkers = await getCollection('missionaries');
const carouselMissionaries = (
  await Promise.all(
    allWorkers
      .sort((a, b) => a.data.name.localeCompare(b.data.name))
      .map(async (m) => {
        if (m.data.picture === 'none.jpg') return null;
        const mod = portraitModules[`/src/assets/images/${m.data.picture}`];
        if (!mod?.default) return null;
        const opt = await getImage({ src: mod.default, format: 'webp', width: 416, height: 540, quality: 82 });
        return { name: m.data.name, url: m.data.url, location: m.data.location, pictureUrl: opt.src };
      })
  )
).filter((m): m is NonNullable<typeof m> => m !== null);

// FINAL v2 meta description (homepage)
const description =
  'Behind every missionary is a story no one sees. YES stands with faithful Gospel workers already in the field, carrying more than anyone should carry alone. Since 1990.';

// Transparency seal lives in public/ — referenced directly
const sealSrc = `${base}images/candid-seal-platinum-2025.png`;
---

<BaseLayout title="Behind Every Missionary Is a Story No One Sees · YES (Yielded Evangelical Servants)" description={description} preloadImage={heroImages[0]}>
  {/* 1 — Hero: eyebrow, headline, opening paragraph, pull-quote, CTAs */}
  <Hero base={base} heroImages={heroImages} client:load />

  {/* 2 — Stats strip: 35+ · 20+ · Platinum · 501(c)(3) */}
  <HomeStats base={base} sealSrc={sealSrc} client:visible />

  {/* 3 — The Investment (bridge pull-quote + Matthew 6:19-20) */}
  <HomeInvestment base={base} client:visible />

  {/* 4 — What Makes YES Different (4 numbered points) */}
  <HomeDifferent base={base} client:visible />

  {/* 5 — The Model (comparison ledger: Sent from the US vs YES) */}
  <HomeModel base={base} client:visible />

  {/* 6 — Where Your Partnership Goes (chain quote + 4 areas) */}
  <HomeSupport base={base} client:visible />

  {/* 7 — Special Projects (Priority 01: pastor's home · 02: gathering place) */}
  <HomeProjects base={base} client:visible />

  {/* 8 — The Body of Christ (1 Cor 12:26-27 · Luke 6:38) */}
  <HomeBiblical base={base} client:visible />

  {/* 9 — Why Trust YES (paragraph + 5 credential pills) */}
  <HomeTrust base={base} client:visible />

  {/* 10 — Final CTA (orange box, signed by Andres, closes on John 13:35) */}
  <HomeFinalCta
    base={base}
    andresImg={{ src: andresImg.src }}
    client:visible
  />

  {/* The Missionaries procession — client directive: carousel at the very end */}
  <HomeMissionaries base={base} missionaries={carouselMissionaries} client:visible />

  <Footer base={base} client:visible />
</BaseLayout>
