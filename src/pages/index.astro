---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import Footer from '../components/Footer';
import HomeReality from '../components/HomeReality';
import HomeFieldStories from '../components/HomeFieldStories';
import HomeDifference from '../components/HomeDifference';
import HomeWhatYesDoes from '../components/HomeWhatYesDoes';
import HomeWhyYes from '../components/HomeWhyYes';
import HomeWhoWeAre from '../components/HomeWhoWeAre';
import HomeBiblical from '../components/HomeBiblical';
import HomeFinalCta from '../components/HomeFinalCta';

// Hero carousel field photos → WebP (dignified, real field photography)
import hero1Src from '../assets/images/yespic/IMG-20240810-WA0010.jpg';
import hero2Src from '../assets/images/yespic/IMG-20240810-WA0012.jpg';
import hero3Src from '../assets/images/yespic/IMG-20240810-WA0009.jpg';
import hero4Src from '../assets/images/yespic/9.jpg';

// Field story photos — stand-ins; CLIENT must replace with verified location photos
// Section 3 story 1: Bajo Rodríguez, Costa Rica stand-in
import story1Src from '../assets/images/yespic/1.jpg';
// Section 3 story 2: Mata Hambre, Honduras stand-in
import story2Src from '../assets/images/yespic/IMG-20240810-WA0007.jpg';
// Section 3 story 3: Ozamiz, Philippines stand-in
import story3Src from '../assets/images/yespic/2.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const heroSrcs = [hero1Src, hero2Src, hero3Src, hero4Src];
const heroImages = (
  await Promise.all(
    heroSrcs.map((src) => getImage({ src, format: 'webp', width: 880, height: 1100, quality: 82 }))
  )
).map((img) => img.src);

// Section 3 story images → WebP
/* CLIENT: replace stand-in photos with verified field photos for each location */
const story1Img = await getImage({ src: story1Src, format: 'webp', width: 720, height: 540, quality: 82 });
const story2Img = await getImage({ src: story2Src, format: 'webp', width: 720, height: 540, quality: 82 });
const story3Img = await getImage({ src: story3Src, format: 'webp', width: 720, height: 540, quality: 82 });

const description =
  "YES (Yielded Evangelical Servants) has strengthened missionaries, pastors, evangelists, and church planters for more than 35 years — sustaining faithful Gospel workers in some of the world's most difficult places.";

// Transparency seal lives in public/ — referenced directly
const sealSrc = `${base}images/candid-seal-platinum-2025.png`;
---

<BaseLayout title="Strengthening Gospel Workers · YES (Yielded Evangelical Servants)" description={description} preloadImage={heroImages[0]}>
  {/* Section 1 — Hero */}
  <Hero base={base} heroImages={heroImages} client:load />

  {/* Section 2 — The Reality on the Ground */}
  <HomeReality base={base} client:visible />

  {/* Section 3 — Thirty-Five Years of Witness (three field stories) */}
  <HomeFieldStories
    base={base}
    story1Img={{ src: story1Img.src, alt: "A faithful pastor and his congregation in Bajo Rodríguez, Costa Rica — stand-in photo" }}
    story2Img={{ src: story2Img.src, alt: "Gospel workers serving in the Mata Hambre community, Honduras — stand-in photo" }}
    story3Img={{ src: story3Img.src, alt: "Ministry workers in Ozamiz, Philippines — stand-in photo" }}
    client:visible
  />

  {/* Section 4 — The Difference YES Makes */}
  <HomeDifference base={base} client:visible />

  {/* Section 5 — What YES Does (3 cards) */}
  <HomeWhatYesDoes base={base} client:visible />

  {/* Section 6 — Why YES (4 points) */}
  <HomeWhyYes base={base} client:visible />

  {/* Section 7 — Who We Are (stat row + transparency) */}
  <HomeWhoWeAre base={base} sealSrc={sealSrc} client:visible />

  {/* Section 8 — Biblical Foundation */}
  <HomeBiblical base={base} client:visible />

  {/* Section 9 — Final CTA */}
  <HomeFinalCta base={base} client:visible />

  <Footer base={base} client:visible />
</BaseLayout>
