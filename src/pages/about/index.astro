---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer';
import PageHero from '../../components/PageHero';
import AboutStory from '../../components/AboutStory';
import AboutStories from '../../components/AboutStories';
import AboutBeliefs from '../../components/AboutBeliefs';
import AboutWorkers from '../../components/AboutWorkers';
import AboutStats from '../../components/AboutStats';
import AboutPerson from '../../components/AboutPerson';

import rawFamilyImage from '../../assets/images/yespic/latour-family-field.jpg';
import rawCoupleImage from '../../assets/images/yespic/latour-couple.jpg';
import rawAndresImage from '../../assets/images/andres.jpeg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/* ── WebP optimisation ────────────────────────────────────── */
// Founders Bernie & Jean LaTour — the historic field photo (with the mission plane)
const familyImage = await getImage({
  src: rawFamilyImage,
  format: 'webp',
  width: 900,
  height: 612,
  quality: 82,
});
// Bernie & Jean LaTour today — the "then and now" inset portrait
const coupleImage = await getImage({
  src: rawCoupleImage,
  format: 'webp',
  width: 500,
  height: 500,
  quality: 84,
});

// Andrés González — President (The Person Behind YES)
const andresImage = await getImage({
  src: rawAndresImage,
  format: 'webp',
  width: 640,
  height: 800,
  quality: 82,
});

// FINAL v2 meta description (About)
const description =
  'YES was built by missionaries who saw faithful workers standing alone — and decided that had to change. 35 years. 20+ nations. Platinum-rated.';
---

<BaseLayout title="About YES — Yielded Evangelical Servants" description={description}>
  <!-- Block 1: Opener — "YES Did Not Begin in a Boardroom. It Began in the Field." -->
  <PageHero eyebrowKey="about_opener_eyebrow" headlineKey="about_opener_headline" client:load />

  <!-- Block 1 (cont.): The Beginning — light -->
  <AboutStory base={base} familyImage={familyImage.src} coupleImage={coupleImage.src} client:visible />

  <!-- Block 2: What We Saw That We Couldn't Unsee — dark espresso -->
  <AboutStories base={base} client:visible />

  <!-- Block 3: What We Believe (5 convictions) — light -->
  <AboutBeliefs base={base} client:visible />

  <!-- Block 4: Who YES Stands With — light -->
  <AboutWorkers base={base} client:visible />

  <!-- Closing stats band — 35 Years of Field-Proven Partnership -->
  <AboutStats base={base} client:visible />

  <!-- The Person Behind YES — Andrés González (FINAL v2 new section) -->
  <AboutPerson base={base} andresImage={andresImage.src} client:visible />

  <Footer base={base} client:visible />
</BaseLayout>
