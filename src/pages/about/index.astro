---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer';
import PageHero from '../../components/PageHero';
import AboutStory from '../../components/AboutStory';
import AboutDifferent from '../../components/AboutDifferent';
import AboutBeliefs from '../../components/AboutBeliefs';
import AboutPeople from '../../components/AboutPeople';
import AboutWorkers from '../../components/AboutWorkers';

import rawStoryImage from '../../assets/images/yespic/1.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/* ── WebP optimisation ────────────────────────────────────── */
const storyImage = await getImage({
  src: rawStoryImage,
  format: 'webp',
  width: 640,
  height: 800,
  quality: 80,
});
/* CLIENT: replace rawStoryImage with a verified Yanomàmö/Venezuela photo */
---

<BaseLayout
  title="About YES — Yielded Evangelical Servants"
  description="Founded by missionaries who served the Yanomàmö people of Venezuela, YES has spent more than three decades building trusted partnerships with Gospel workers around the world."
>
  <!-- Section 1: Opener — shared PageHero -->
  <PageHero eyebrowKey="about_opener_eyebrow" headlineKey="about_opener_headline" introKey="about_opener_body" client:load />

  <!-- Section 2: Our Story — light -->
  <AboutStory
    base={base}
    storyImage={storyImage.src}
    client:visible
  />

  <!-- Section 3: What Makes YES Different — dark green -->
  <AboutDifferent base={base} client:visible />

  <!-- Section 4: What We Believe — light -->
  <AboutBeliefs base={base} client:visible />

  <!-- Section 5: The People Behind YES — dark green (placeholder) -->
  <AboutPeople base={base} client:visible />

  <!-- Section 6: The Workers YES Strengthens — light -->
  <AboutWorkers base={base} client:visible />

  <Footer base={base} client:visible />
</BaseLayout>
