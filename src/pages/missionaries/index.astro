---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer';
import GwOpener from '../../components/GwOpener';
import GwStories from '../../components/GwStories';
import GwProfiles from '../../components/GwProfiles';
import GwCta from '../../components/GwCta';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// ── Image modules ──────────────────────────────────────────────────────────
const portraitModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.{jpg,jpeg,png}',
  { eager: true }
);
const yespicModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/yespic/*.{jpg,jpeg,png}',
  { eager: true }
);

// ── Field stories photos ───────────────────────────────────────────────────
// Same location-verified photos used on the homepage letter (CR · HN · PH).
const storySrcs: Array<{ key: string; w: number; h: number }> = [
  // Bajo Rodríguez, Costa Rica
  { key: '/src/assets/images/yespic/costa-rica-bajo-rodriguez.jpg', w: 720, h: 480 },
  // Mata Hambre, Honduras
  { key: '/src/assets/images/yespic/honduras-mata-hambre.jpg', w: 720, h: 480 },
  // Ozamiz, Philippines
  { key: '/src/assets/images/yespic/philippines-ozamiz.jpg', w: 720, h: 480 },
];

const storyPhotos = await Promise.all(
  storySrcs.map(async ({ key, w, h }) => {
    const mod = yespicModules[key] ?? portraitModules[key];
    if (!mod?.default) return { src: '' };
    const opt = await getImage({ src: mod.default, format: 'webp', width: w, height: h, quality: 85 });
    return { src: opt.src };
  })
);

// ── Worker collection ──────────────────────────────────────────────────────
const allWorkers = await getCollection('missionaries');
const workers = await Promise.all(
  allWorkers
    .sort((a, b) => a.data.name.localeCompare(b.data.name))
    .map(async (m) => {
      const key = `/src/assets/images/${m.data.picture}`;
      const mod = portraitModules[key];
      let pictureUrl: string | undefined;
      if (mod?.default) {
        const opt = await getImage({
          src: mod.default,
          format: 'webp',
          width: 288,
          height: 288,
          quality: 85,
        });
        pictureUrl = opt.src;
      }
      return { ...m.data, pictureUrl };
    })
);
---

<BaseLayout
  title="The Missionaries — Yielded Evangelical Servants"
  description="Meet the pastors, evangelists and church planters YES walks alongside — already in the field, already faithful, already bearing fruit."
>
  <!-- Block 1 — Opener (shared PageHero) -->
  <GwOpener client:load />

  <!-- Block 2 — Three Stories (full versions) -->
  <!-- CLIENT: replace stand-in photos with verified field location photographs -->
  <GwStories photos={storyPhotos} client:visible />

  <!-- Block 3 — Worker Profiles (collection) -->
  <GwProfiles missionaries={workers} base={base} client:visible />

  <!-- Block 4 — CTA: "One worker who stays changes the region around them." -->
  <GwCta base={base} client:visible />

  <Footer base={base} client:visible />
</BaseLayout>
