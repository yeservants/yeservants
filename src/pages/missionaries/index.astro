---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MissionariesGrid from '../../components/MissionariesGrid';
import Footer from '../../components/Footer';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allMissionaries = await getCollection('missionaries');
const sorted = allMissionaries
  .map((m) => m.data)
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Our Missionaries — Y.E.S." description="Meet the evangelical missionaries supported by Yielded Evangelical Servants worldwide.">

  <!-- Hero -->
  <section class="relative pt-36 pb-20 md:pt-44 md:pb-28 overflow-hidden bg-[var(--color-bg)]">
    <div class="absolute font-heading font-bold text-[clamp(4rem,14vw,12rem)] top-[45%] left-1/2 -translate-x-1/2 leading-none pointer-events-none select-none whitespace-nowrap" style="color:rgba(44,74,62,0.06)" aria-hidden="true">MISSIONARIES</div>
    <div class="float-line h-[30vh] top-[10%] left-[4%]" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6">
      <p class="text-[var(--color-accent)] text-xs tracking-[0.25em] uppercase font-medium mb-4">Around the World</p>
      <h1 class="font-heading text-4xl md:text-6xl lg:text-7xl font-light text-[var(--color-primary)] leading-[1.05] mb-6">
        Meet Our Missionaries
      </h1>
      <p class="text-[var(--color-text-muted)] text-lg md:text-xl leading-relaxed max-w-2xl">
        Serving in over 20 nations — reaching the unreached, planting churches, and showing the love of Christ in practical ways.
      </p>
      <p class="text-[var(--color-text-muted)] text-sm mt-4 max-w-2xl">
        Some missionaries are not listed publicly for their safety, as they serve in regions where sharing the Gospel may involve risk or persecution.
      </p>
    </div>
  </section>

  <MissionariesGrid missionaries={sorted} base={base} client:load />
  <Footer base={base} client:visible />
</BaseLayout>
