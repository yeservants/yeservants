---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer';
import PageHero from '../../components/PageHero';
import WorkMissionarySupport from '../../components/WorkMissionarySupport';
import WorkChurchPlanting from '../../components/WorkChurchPlanting';
import WorkEvangelism from '../../components/WorkEvangelism';
import WorkMissionTeams from '../../components/WorkMissionTeams';
import WorkLeadership from '../../components/WorkLeadership';
import WorkThirtyFiveYears from '../../components/WorkThirtyFiveYears';
import missionarySrc from '../../assets/images/yespic/2.jpg';
import churchSrc from '../../assets/images/kids.jpg';
import evangelismSrc from '../../assets/images/yespic/9.jpg';
import teamsSrc from '../../assets/images/BocaTrip.png';
import leadershipSrc from '../../assets/images/yespic/IMG-20240810-WA0007.jpg';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const missionaryImg = await getImage({ src: missionarySrc, format: 'webp', width: 560, height: 747, quality: 82 });
const churchImg = await getImage({ src: churchSrc, format: 'webp', width: 520, height: 693, quality: 82 });
const evangelismImg = await getImage({ src: evangelismSrc, format: 'webp', width: 520, height: 650, quality: 82 });
const teamsImg = await getImage({ src: teamsSrc, format: 'webp', width: 560, height: 700, quality: 82 });
const leadershipImg = await getImage({ src: leadershipSrc, format: 'webp', width: 420, height: 560, quality: 82 });
const description = "Thirty-five years of Gospel partnership: missionary support, church planting, evangelism, mission teams, and leadership development in some of the world's most difficult places.";
---
<BaseLayout title="Our Work · YES (Yielded Evangelical Servants)" description={description}>
  {/* CLIENT: replace stand-in photos with verified topic photos */}
  <PageHero eyebrowKey="work_hero_label" headlineKey="work_hero_headline" introKey="work_hero_body" client:load />
  <WorkMissionarySupport fieldPhoto={missionaryImg.src} client:visible />
  <WorkChurchPlanting fieldPhoto={churchImg.src} client:visible />
  <WorkEvangelism fieldPhoto={evangelismImg.src} client:visible />
  <WorkMissionTeams fieldPhoto={teamsImg.src} base={base} client:visible />
  <WorkLeadership fieldPhoto={leadershipImg.src} client:visible />
  <WorkThirtyFiveYears base={base} client:visible />
  <Footer base={base} client:visible />
</BaseLayout>
