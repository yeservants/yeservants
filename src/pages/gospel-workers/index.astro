---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer';
import GwOpener from '../../components/GwOpener';
import GwStories from '../../components/GwStories';
import GwLongTerm from '../../components/GwLongTerm';
import GwProfiles from '../../components/GwProfiles';
import GwQuotes from '../../components/GwQuotes';
import GwCta from '../../components/GwCta';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// ── Image modules ──────────────────────────────────────────────────────────
const portraitModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.{jpg,jpeg,png}',
  { eager: true }
);
const yespicModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/yespic/*.{jpg,jpeg,png}',
  { eager: true }
);

// ── Field stories photos ───────────────────────────────────────────────────
// Stand-in field photos (no location-verified photos for these stories)
const storySrcs: Array<{ key: string; w: number; h: number }> = [
  // Bajo Rodríguez CR — stand-in
  { key: '/src/assets/images/yespic/1.jpg', w: 720, h: 480 },
  // Mata Hambre HN — stand-in
  { key: '/src/assets/images/yespic/9.jpg', w: 720, h: 480 },
  // Ozamiz PH — stand-in
  { key: '/src/assets/images/BocaTrip.png', w: 720, h: 480 },
];

const storyPhotos = await Promise.all(
  storySrcs.map(async ({ key, w, h }) => {
    const mod = yespicModules[key] ?? portraitModules[key];
    if (!mod?.default) return { src: '' };
    const opt = await getImage({ src: mod.default, format: 'webp', width: w, height: h, quality: 85 });
    return { src: opt.src };
  })
);

// ── Worker collection ──────────────────────────────────────────────────────
const allWorkers = await getCollection('missionaries');
const workers = await Promise.all(
  allWorkers
    .sort((a, b) => a.data.name.localeCompare(b.data.name))
    .map(async (m) => {
      const key = `/src/assets/images/${m.data.picture}`;
      const mod = portraitModules[key];
      let pictureUrl: string | undefined;
      if (mod?.default) {
        const opt = await getImage({
          src: mod.default,
          format: 'webp',
          width: 288,
          height: 288,
          quality: 85,
        });
        pictureUrl = opt.src;
      }
      return { ...m.data, pictureUrl };
    })
);
---

<BaseLayout
  title="Gospel Workers — Yielded Evangelical Servants"
  description="Meet the missionaries, pastors, evangelists, and church planters YES has walked alongside for more than three decades."
>
  <!-- Section 1 — Opener (shared PageHero) -->
  <GwOpener client:load />

  <!-- Section 2 — What This Work Actually Costs (field stories) -->
  <!-- CLIENT: replace stand-in photos with verified field location photographs -->
  <GwStories photos={storyPhotos} client:visible />

  <!-- Section 3 — The Long-Term Difference -->
  <GwLongTerm client:visible />

  <!-- Section 4 — Worker Profiles (33-entry collection) -->
  <GwProfiles missionaries={workers} base={base} client:visible />

  <!-- Section 5 — In Their Own Words -->
  <!-- CLIENT: provide unedited worker quotes to replace placeholder -->
  <GwQuotes client:visible />

  <!-- Section 6 — CTA -->
  <GwCta base={base} client:visible />

  <Footer base={base} client:visible />
</BaseLayout>
