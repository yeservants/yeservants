---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Preload the LCP image (e.g. the hero photo) so Lighthouse discovers it first. */
  preloadImage?: string;
}

const {
  title,
  description = 'Behind every missionary is a story no one sees. YES stands with faithful Gospel workers already in the field, carrying more than anyone should carry alone. Since 1990.',
  canonicalUrl,
  ogImage = 'images/og-home.jpg',
  ogType = 'website',
  noindex = false,
  preloadImage,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Derive absolute URLs from the configured deploy origin so OG images and
// JSON-LD always RESOLVE on the live site. (Moving to a custom domain later
// only requires changing `site` in astro.config.mjs.)
const origin = Astro.site?.origin ?? 'https://fpsjago.github.io';
const homeUrl = `${origin}${base}`;
const canonical = canonicalUrl ?? Astro.url.href;
const toAbs = (p: string) => {
  if (p.startsWith('http')) return p;
  if (p.startsWith(base)) return `${origin}${p}`; // already base-prefixed (e.g. getImage output)
  return `${origin}${base}${p.replace(/^\//, '')}`; // base-relative, e.g. 'images/og-home.jpg'
};
const ogImageFull = toAbs(ogImage);

const fontHref =
  'https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@0,300..700;1,400..700&display=swap';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NonprofitOrganization',
  name: 'Yielded Evangelical Servants, Inc.',
  alternateName: 'YES',
  url: homeUrl,
  logo: toAbs('yes_logo-04.webp'),
  slogan: 'YES finds the faithful workers nobody is standing with — and stands with them.',
  description: 'A missionary-founded 501(c)(3) nonprofit ministry. Since 1990, YES has stood with faithful Gospel workers already serving in the field — providing the financial and logistical support that lets them stop surviving and start thriving.',
  foundingDate: '1990',
  taxID: '54-1558343',
  nonprofitStatus: 'Nonprofit501c3',
  email: 'info@yeservants.org',
  telephone: '+1-407-498-5128',
  sameAs: [],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'PO Box 770308',
    addressLocality: 'Orlando',
    addressRegion: 'FL',
    postalCode: '32837',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'Place',
    name: 'Worldwide',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Yielded Evangelical Servants',
  alternateName: 'YES',
  url: homeUrl,
  inLanguage: ['en', 'es'],
  publisher: { '@type': 'NonprofitOrganization', name: 'Yielded Evangelical Servants, Inc.' },
};
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#33241A" />

  {/* Preload the LCP hero image — prioritizes it in the discovery graph for faster LCP */}
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageFull} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Yielded Evangelical Servants — Missionaries in the field" />
  <meta property="og:site_name" content="Yielded Evangelical Servants" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="es_ES" />
  <meta http-equiv="content-language" content="en, es" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageFull} />
  <meta name="twitter:image:alt" content="Yielded Evangelical Servants — Missionaries in the field" />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />

  <!-- Keep <html lang> in sync with the reader's chosen language before first paint -->
  <script is:inline>
    try {
      var l = localStorage.getItem('yes_lang');
      if (l === 'en' || l === 'es') document.documentElement.lang = l;
    } catch (e) {}
  </script>

  <!-- Fonts — Playfair Display (display) + Lora (body). Loaded async so the
       stylesheet never blocks first paint; display=swap renders fallback text
       immediately, then swaps. <noscript> keeps it working without JS. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href={fontHref} onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href={fontHref} /></noscript>

  <ClientRouter />
</head>
<body class="grain bg-[var(--color-bg)] text-[var(--color-text)]">
  <noscript>
    <style>
      [data-reveal], [data-reveal-stagger] > * { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-accent-deep)] focus:text-white focus:rounded">Skip to main content</a>
  <Nav client:only="react" base={base} transition:persist />
  <main id="main-content">
    <slot />
  </main>
</body>
</html>

<script>
  import Lenis from 'lenis';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  let lenis: Lenis | null = null;

  // Mark once a ClientRouter view transition has occurred. Islands (e.g. the Hero)
  // use this to SKIP heavy intro animations on SPA navigation — only the initial
  // full page load animates. Prevents SplitText line-mask flashes during transitions.
  document.addEventListener('astro:before-swap', () => {
    Object.assign(window, { __yesSwapped: true });
  });

  function initScrolling() {
    if (lenis) { lenis.destroy(); lenis = null; }
    lenis = new Lenis({
      duration: 1.3,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      smoothWheel: true,
    });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time: number) => { lenis?.raf(time * 1000); });
    gsap.ticker.lagSmoothing(0);
  }

  document.addEventListener('astro:before-preparation', () => {
    if (lenis) { lenis.destroy(); lenis = null; }
    gsap.killTweensOf('*');
    ScrollTrigger.getAll().forEach(t => t.kill());
  });

  document.addEventListener('astro:page-load', initScrolling);
</script>

<script is:inline data-astro-rerun>
  (function() {
    if (window._revealAbort) window._revealAbort.abort();
    window._revealAbort = new AbortController();
    function initReveals() {
      if (window.scrollRevealObserver) window.scrollRevealObserver.disconnect();
      window.scrollRevealObserver = new IntersectionObserver(
        function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) e.target.classList.add('visible');
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach(function(el) {
        if (el.closest('astro-island')) return;
        window.scrollRevealObserver.observe(el);
      });
      // Backstop for content already in the viewport on load (islands included),
      // after hydration has settled. Safe: additive only, runs post-hydration.
      setTimeout(sweepReveals, 500);
      setTimeout(sweepReveals, 1400);
    }

    // Safety net: a scroll-driven sweep that reveals ANY [data-reveal] element
    // (including those inside React islands) once it has entered the viewport.
    // Runs only on user scroll (always post-hydration → no #418 risk) and is
    // additive (only ever adds .visible). Backstops the per-island Intersection
    // Observers so a section can never stay blank after a fast scroll, a slow
    // hydration, or a dev-server timing hiccup.
    var sweepScheduled = false;
    function sweepReveals() {
      sweepScheduled = false;
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var nodes = document.querySelectorAll('[data-reveal]:not(.visible), [data-reveal-stagger]:not(.visible)');
      for (var i = 0; i < nodes.length; i++) {
        var r = nodes[i].getBoundingClientRect();
        if (r.top < vh * 0.92 && r.bottom > -200) nodes[i].classList.add('visible');
      }
    }
    function onScroll() {
      if (sweepScheduled) return;
      sweepScheduled = true;
      requestAnimationFrame(sweepReveals);
    }
    window.addEventListener('scroll', onScroll, { passive: true, signal: window._revealAbort.signal });

    document.addEventListener('astro:page-load', initReveals, { signal: window._revealAbort.signal });
  })();
</script>
