---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = 'Yielded Evangelical Servants (Y.E.S.) is a nonprofit 501(c)(3) mission organization supporting evangelical missionaries worldwide since 1990.',
  canonicalUrl,
  ogImage = '/images/homepage-children.jpg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = 'https://yeservants.org';
const canonical = canonicalUrl ?? Astro.url.href;
const ogImageFull = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NonprofitOrganization',
  name: 'Yielded Evangelical Servants, Inc.',
  alternateName: 'Y.E.S.',
  url: siteUrl,
  logo: `${siteUrl}/images/logo.png`,
  description: 'A nonprofit 501(c)(3) Christian mission organization founded in 1990, providing financial accountability and administrative services for evangelical missionaries worldwide.',
  foundingDate: '1990',
  taxID: '501(c)(3)',
  email: 'info@yeservants.org',
  sameAs: [],
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'Place',
    name: 'Worldwide',
  },
};
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#2C4A3E" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageFull} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Yielded Evangelical Servants — Missionaries in the field" />
  <meta property="og:site_name" content="Yielded Evangelical Servants" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageFull} />
  <meta name="twitter:image:alt" content="Yielded Evangelical Servants — Missionaries in the field" />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="apple-touch-icon" href={`${base}favicon.ico`} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&display=swap" rel="stylesheet" />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap" rel="stylesheet" />

  <ClientRouter />
</head>
<body class="grain bg-[var(--color-bg)] text-[var(--color-text)]">
  <noscript>
    <style>
      [data-reveal], [data-reveal-stagger] > * { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-accent)] focus:text-white focus:rounded">Skip to main content</a>
  <Nav client:only="react" base={base} transition:persist />
  <main id="main-content">
    <slot />
  </main>
</body>
</html>

<script>
  import Lenis from 'lenis';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  let lenis: Lenis | null = null;

  function initScrolling() {
    if (lenis) { lenis.destroy(); lenis = null; }
    lenis = new Lenis({
      duration: 1.3,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      smoothWheel: true,
    });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time: number) => { lenis?.raf(time * 1000); });
    gsap.ticker.lagSmoothing(0);
  }

  document.addEventListener('astro:before-preparation', () => {
    if (lenis) { lenis.destroy(); lenis = null; }
    gsap.killTweensOf('*');
    ScrollTrigger.getAll().forEach(t => t.kill());
  });

  document.addEventListener('astro:page-load', initScrolling);
</script>

<script is:inline data-astro-rerun>
  (function() {
    if (window._revealAbort) window._revealAbort.abort();
    window._revealAbort = new AbortController();
    function initReveals() {
      if (window.scrollRevealObserver) window.scrollRevealObserver.disconnect();
      window.scrollRevealObserver = new IntersectionObserver(
        function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) e.target.classList.add('visible');
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach(function(el) {
        if (el.closest('astro-island')) return;
        window.scrollRevealObserver.observe(el);
      });
    }
    document.addEventListener('astro:page-load', initReveals, { signal: window._revealAbort.signal });
  })();
</script>
